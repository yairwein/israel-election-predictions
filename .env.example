# Google Identity Services OAuth client (Web application). Add every origin you serve from
# (http://localhost:5173, https://<service>.run.app, your domain) to "Authorized JavaScript origins".
GOOGLE_CLIENT_ID=""

# HMAC secret for the session cookie (32+ random bytes). `openssl rand -base64 48`
SESSION_SECRET=""

# local (./data) or gcs
STORAGE_BACKEND="local"
GCS_BUCKET=""
DATA_DIR="./data"

# Predictions lock 24h before the election start. ISO 8601 with offset.
# Israel switches to winter time (UTC+2) on 25 Oct 2026.
ELECTION_AT="2026-10-27T08:00:00+02:00"
LOCK_AT="2026-10-26T08:00:00+02:00"

# NODE_ENV=dev (or `npm run dev`): login is optional. Without a session you vote as a local
# test voter. Google sign-in still works, and "dev sign-in as…" simulates more voters.
# Ignored on Cloud Run (K_SERVICE set), so production always requires Google sign-in.
# NODE_ENV="dev"

# Optional: hide the totals until this time (ISO 8601).
# RESULTS_HIDDEN_UNTIL=""
