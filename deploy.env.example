# Copy to deploy.env (git-ignored) and fill in. ./deploy.sh reads it.

# Google Cloud
PROJECT=""            # GCP project id
REGION=""             # Cloud Run region, e.g. us-central1
SERVICE=""            # Cloud Run service name
BUCKET=""             # GCS bucket for predictions (created by `./deploy.sh setup`)
DOMAIN=""             # custom domain mapped by `./deploy.sh domain`

# App
GOOGLE_CLIENT_ID=""   # OAuth web client id (public)
PUBLIC_ORIGIN=""      # e.g. https://your.domain, used in share links and og:image
ELECTION_AT=""        # polls open, ISO 8601 with offset, e.g. 2026-10-27T07:00:00+02:00
LOCK_AT=""            # predictions lock, e.g. 2026-10-26T19:00:00+02:00
GA_MEASUREMENT_ID=""  # optional, Google Analytics 4 id (G-...)
OAUTH_CLIENT_SECRET_NAME=""  # optional, Secret Manager name of the OAuth client secret (redirect sign-in in in-app browsers)
